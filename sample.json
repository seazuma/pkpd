{
  "sample1": { // This top-level key is used as the CSV filename in the downloaded ZIP
    "StudyID": "sample1", // Ignored by this tool; extra fields are allowed
    "t1": 0,  // Required: simulation start time [min]
    "t2": 60, // Required: simulation end time [min]
    "dt": 1, // Optional: calculation interval [min]; defaults to 3/60 if omitted
    "patient": { // Required: same format as JSON output from AnesSimulator
      "age": "60", // years
      "sex": 1, // 0, "male", or "m": male; 1, "female", or "f": female
      "height": "150", // cm
      "weight": "50", // kg
      "high_ASA": false // false: ASA-PS 1 or 2; true: ASA-PS 3 or 4
    },
    "data": { // Required: same format as JSON output from AnesSimulator
      "Fentanyl": { // Used in CSV column headers; different labels are simulated separately
        "agent": "Fentanyl", // Drug name; see the excerpt below for accepted names
        "row_arr": [ // Required: row data
          {
            "unit": "mL", // Unit
            "entry_at": {
              "10": "2" // "minute": "dose"
            }
          }
        ]
      },
      "Propofol": {
        "agent": "Propofol",
        "row_arr": [
          {
            "unit": "mg",
            "entry_at": {
              "10": "70"
            }
          },
          {
            "unit": "mg/h",
            "entry_at": {
              "10": "250",
              "40": "0"
            }
          }
        ]
      }
    }
  },
  "sample2": {
    "StudyID": "sample2",
    "t1": 0,
    "t2": 60,
    "dt": 1,
    "patient": {
      "age": "60",
      "sex": 1,
      "height": "150",
      "weight": "50",
      "high_ASA": false
    },
    "data": {
      "Propofol": {
        "agent": "Propofol",
        "preset_model_g": "model_P_M1991", // Optional: calculation model; see the excerpt below; uses the latest model if omitted
        "row_arr": [
          {
            "unit": "ug/mL", // ug, mcg, and μg are all accepted
            "TCI_model_g": "model_P_M1991", // Required: TCI model; see the excerpt below
            "entry_at": {
              "10.0": "3",
              "40.0": "0"
            }
          }
        ]
      }
    }
  }
}
